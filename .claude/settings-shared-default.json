{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-5",
  "fallbackModel": [
    "claude-haiku-4-5"
  ],
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90"
  },
  "enabledMcpjsonServers": [
    "context7"
  ],
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Bash(scripts/dev-task.sh *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash*)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(yarn run *)",
      "Bash(pytest*)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(gofmt *)",
      "Bash(go test*)",
      "Bash(go build*)",
      "Bash(go vet*)",
      "Bash(cargo fmt*)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(cargo clippy*)",
      "Bash(dotnet *)",
      "Bash(mvn *)",
      "Bash(./gradlew *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(composer *)",
      "Bash(bundle exec *)",
      "Bash(mix *)",
      "Bash(deno *)",
      "Bash(swift *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr merge --auto *)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(scripts/maintenance-sweep.sh *)",
      "Bash(scripts/arch-health-radar.sh*)",
      "Bash(scripts/subagent-dispatch.sh *)",
      "Bash(scripts/spec-compiler.sh *)",
      "Bash(scripts/telemetry-log.sh *)",
      "Bash(scripts/usage-estimate.sh *)",
      "Bash(scripts/test-*)",
      "Bash(scripts/check-*)",
      "Bash(python3 scripts/*)",
      "Bash(python3 tests/*)",
      "Bash(node scripts/*)",
      "Bash(npx --no-install *)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebSearch",
      "mcp__context7"
    ],
    "deny": [
      "Bash(git push --force * main*)",
      "Bash(git push --force * master*)",
      "Bash(git push --force *:main*)",
      "Bash(git push --force *:master*)",
      "Bash(git push --force-with-lease* main*)",
      "Bash(git push --force-with-lease* master*)",
      "Bash(git push --force-with-lease*:main*)",
      "Bash(git push --force-with-lease*:master*)",
      "Bash(git push -f * main*)",
      "Bash(git push -f * master*)",
      "Bash(git push -f *:main*)",
      "Bash(git push -f *:master*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(dd *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/.env)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(git push * +*main*)",
      "Bash(git push * +*master*)",
      "Bash(git push * --delete *main*)",
      "Bash(git push * --delete *master*)",
      "Bash(git push -f*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- .*)",
      "Bash(git restore -- .*)",
      "Bash(npm publish*)",
      "Bash(cargo publish*)",
      "Bash(mvn deploy*)",
      "Bash(dotnet nuget push*)",
      "Bash(flutter pub publish*)",
      "Bash(./gradlew publish*)",
      "Bash(deno run -A https://*)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease*)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh release *)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr merge --delete-branch*)",
      "Bash(git diff --no-index*)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(scripts/_commit-guard.sh)",
      "Edit(scripts/dev-task.sh)",
      "Edit(scripts/_dev-task-verify.sh)",
      "Edit(scripts/_stack-detect.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-resume.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-guide.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-format.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ui-intelligence.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/telemetry-record.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/telemetry-record.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/precompact-checkpoint.sh"
          }
        ]
      }
    ]
  }
}
